# Faucet server
PORT=8097
# Reverse-proxy client-IP header (e.g. X-Forwarded-For). Leave blank when the
# faucet is directly exposed — otherwise clients can spoof their IP and evade
# IP bans / geo-block.
IP_HEADER=X-Forwarded-For

# oalgopay gateway
GATEWAY_URL=https://pay.oalgo.space
# Payouts API key (required, non-empty)
PAYOUT_API_KEY=
# Auth API key for wallet sign-in — leave blank to hide the feature
AUTH_API_KEY=

# Admin panel password (required, non-empty)
ADMIN_PASSWORD=

# Cloudflare Turnstile — blank TURNSTILE_SECRET disables the check
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# SQLite database file (default: faucet.db in the repo root). Dev override
# while the old Python faucet still owns faucet.db:
# DB_PATH=faucet.dev.db
# First-boot seed for the amount_bnt setting
AMOUNT_BNT=0.5
